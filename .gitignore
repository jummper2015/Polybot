# .gitignore

# ── CRÍTICO: secretos ─────────────────────────────────────────────────
.claude/skills/settings.json
.env
*.pem
*.key
*_private*
secrets/

# ── Python ────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# ── Virtual envs ──────────────────────────────────────────────────────
venv/
env/
.venv/
.env/

# ── Testing ───────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── IDEs ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Data y resultados ─────────────────────────────────────────────────
data/historical/*.csv
data/historical/*.json
src/backtesting/results/*.json
src/backtesting/results/*.csv

# ── Docker volumes ────────────────────────────────────────────────────
postgres_data/
redis_data/

# ── Logs ──────────────────────────────────────────────────────────────
*.log
logs/

# ── Node / Frontend ─────────────────────────────────────────────────
node_modules/

# ── OS ────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db