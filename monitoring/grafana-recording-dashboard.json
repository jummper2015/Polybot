{
  "dashboard": {
    "title": "PolyBot — Data Recording (P8.1)",
    "uid": "polybot-recording",
    "tags": ["polybot", "recording", "data", "p8.1"],
    "timezone": "utc",
    "schemaVersion": 39,
    "version": 1,
    "refresh": "30s",
    "panels": [
      {
        "id": 1,
        "title": "Recording Status",
        "type": "stat",
        "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "polybot_recording_uptime_seconds > 0",
            "legendFormat": "Uptime"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "mappings": [
              { "type": "value", "value": "0", "text": "❌ DOWN" },
              { "type": "value", "value": "1", "text": "🟢 RECORDING" }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "green", "value": 1 }
              ]
            },
            "unit": "none"
          }
        },
        "options": { "colorMode": "background", "graphMode": "none" }
      },
      {
        "id": 2,
        "title": "Uptime",
        "type": "stat",
        "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "polybot_recording_uptime_seconds",
            "legendFormat": "Uptime"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "dtdurations",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 3600 },
                { "color": "green", "value": 86400 }
              ]
            }
          }
        },
        "options": { "colorMode": "value", "graphMode": "area" }
      },
      {
        "id": 3,
        "title": "Markets Active",
        "type": "stat",
        "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "polybot_recording_markets_active",
            "legendFormat": "Markets"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "none",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 1 },
                { "color": "green", "value": 3 }
              ]
            }
          }
        },
        "options": { "colorMode": "value", "graphMode": "area" }
      },
      {
        "id": 10,
        "title": "Total Ticks Recorded",
        "type": "stat",
        "gridPos": { "x": 0, "y": 4, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "sum(polybot_recording_ticks_total)",
            "legendFormat": "Total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 1000 },
                { "color": "green", "value": 10000 }
              ]
            }
          }
        },
        "options": { "colorMode": "value", "graphMode": "area" }
      },
      {
        "id": 11,
        "title": "Storage Size",
        "type": "stat",
        "gridPos": { "x": 6, "y": 4, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "polybot_recording_storage_size_bytes",
            "legendFormat": "Size"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decbytes",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 524288000 },
                { "color": "red", "value": 1073741824 }
              ]
            }
          }
        },
        "options": { "colorMode": "value", "graphMode": "area" }
      },
      {
        "id": 12,
        "title": "Estimated Data Loss Rate",
        "type": "stat",
        "gridPos": { "x": 12, "y": 4, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(polybot_recording_ws_reconnects_total[1h]) * 100 / (rate(polybot_recording_ticks_total[1h]) + 1)",
            "legendFormat": "Loss %"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "decimals": 3,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "green", "value": null },
                { "color": "yellow", "value": 0.05 },
                { "color": "red", "value": 0.1 }
              ]
            },
            "max": 1,
            "min": 0
          }
        },
        "options": { "colorMode": "background", "graphMode": "area" }
      },
      {
        "id": 13,
        "title": "Tick Rate per Second",
        "type": "stat",
        "gridPos": { "x": 18, "y": 4, "w": 6, "h": 4 },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(polybot_recording_ticks_total[5m])",
            "legendFormat": "{{asset}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "tps",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "yellow", "value": 0.1 },
                { "color": "green", "value": 0.5 }
              ]
            }
          }
        },
        "options": { "colorMode": "value", "graphMode": "area" }
      },
      {
        "id": 20,
        "title": "Tick Rate by Asset (per minute)",
        "type": "graph",
        "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(polybot_recording_ticks_total[1m]) * 60",
            "legendFormat": "{{asset}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "lineInterpolation": "smooth" }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom" }
        }
      },
      {
        "id": 21,
        "title": "WS Reconnects per Hour",
        "type": "graph",
        "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "rate(polybot_recording_ws_reconnects_total[1h]) * 3600",
            "legendFormat": "{{asset}}"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "lineInterpolation": "stepAfter" }
          }
        },
        "options": {
          "legend": { "displayMode": "table", "placement": "bottom" }
        }
      },
      {
        "id": 30,
        "title": "Storage Growth",
        "type": "graph",
        "gridPos": { "x": 0, "y": 16, "w": 8, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "polybot_recording_storage_size_bytes",
            "legendFormat": "Total"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "decbytes",
            "custom": { "lineInterpolation": "smooth" }
          }
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 31,
        "title": "Markets Active Over Time",
        "type": "graph",
        "gridPos": { "x": 8, "y": 16, "w": 8, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "polybot_recording_markets_active",
            "legendFormat": "Markets"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
            "custom": { "lineInterpolation": "stepAfter" }
          }
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      },
      {
        "id": 32,
        "title": "Uptime Trend",
        "type": "graph",
        "gridPos": { "x": 16, "y": 16, "w": 8, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "polybot_recording_uptime_seconds / 86400",
            "legendFormat": "Days"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "dtdays",
            "custom": { "lineInterpolation": "smooth" }
          }
        },
        "options": {
          "legend": { "displayMode": "list", "placement": "bottom" }
        }
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    }
  },
  "folderUid": "",
  "message": "P8.1 Data Recording Dashboard — metrics from record_live_headless.py port :9091",
  "overwrite": true
}
