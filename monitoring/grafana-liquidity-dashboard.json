        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "color": { "mode": "palette-classic" },
            "custom": {
              "drawStyle": "line",
              "lineWidth": 2,
              "fillOpacity": 15,
              "spanNulls": true,
              "showPoints": "auto",
              "pointSize": 5,
              "stacking": { "mode": "none" },
              "lineInterpolation": "stepAfter"
