        "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
        "targets": [
          {
            "refId": "A",
            "expr": "polybot_liquidity_multiplier{asset=\"BTC\",side=\"entry\"}",
            "legendFormat": "Multiplier"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percentunit",
            "min": 0,
            "max": 1,
            "decimals": 2,
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "red", "value": null },
                { "color": "orange", "value": 0.25 },
                { "color": "yellow", "value": 0.50 },
                { "color": "light-green", "value": 0.75 },
                { "color": "green", "value": 0.90 }
              ]
            }
          }
        },
        "options": {
          "showThresholdLabels": true,
          "showThresholdMarkers": true,
          "reduceOptions": { "calcs": ["lastNotNull"], "values": true },
          "orientation": "auto"
        }
      },
