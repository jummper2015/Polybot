      {
        "id": 200,
        "title": "Liquidity Multiplier Timeline — by Asset",
        "type": "timeseries",
        "gridPos": { "x": 0, "y": 6, "w": 12, "h": 8 },
        "targets": [
          {
            "refId": "A",
            "expr": "polybot_liquidity_multiplier{asset=\"BTC\",side=\"entry\"}",
