        "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
        "targets": [
          {"expr": "polybot_regime_current{asset=\"ETH\",window=\"5m\",regime=\"chop\"}", "legendFormat": "CHOP", "refId": "A"},
