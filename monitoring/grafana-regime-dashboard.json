{
  "dashboard": {
    "title": "PolyBot — Regime Awareness (P11.1)",
    "uid": "polybot-regime",
    "tags": ["polybot", "p11.1", "regime", "strategy-switching"],
    "timezone": "browser",
    "refresh": "15s",
    "panels": [
      {
        "id": 1, "type": "stat", "title": "Regime — BTC 5m",
        "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
        "targets": [
          {"expr": "polybot_regime_current{asset=\"BTC\",window=\"5m\",regime=\"chop\"}", "legendFormat": "CHOP", "refId": "A"},
          {"expr": "polybot_regime_current{asset=\"BTC\",window=\"5m\",regime=\"trend\"}", "legendFormat": "TREND", "refId": "B"},
          {"expr": "polybot_regime_current{asset=\"BTC\",window=\"5m\",regime=\"panic\"}", "legendFormat": "PANIC", "refId": "C"},
          {"expr": "polybot_regime_current{asset=\"BTC\",window=\"5m\",regime=\"illiquid\"}", "legendFormat": "ILLIQUID", "refId": "D"},
          {"expr": "polybot_regime_current{asset=\"BTC\",window=\"5m\",regime=\"event_driven\"}", "legendFormat": "EVENT", "refId": "E"}
        ],
        "fieldConfig": { "defaults": { "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": [{"color": "blue"}, {"color": "green", "value": 1}]}, "mappings": [{"type": "value", "options": {"0": {"text": "—", "color": "text"}, "1": {"text": "ACTIVE"}}}], "noValue": "No data" } },
        "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"], "values": true}, "textMode": "value", "orientation": "auto" }
      },
      {
        "id": 2, "type": "stat", "title": "Regime — BTC 15m",
