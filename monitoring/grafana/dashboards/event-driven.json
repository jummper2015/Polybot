    {
      "id": 501,
      "title": "Blocking Markets — Current Status",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "polybot_event_active == 1",
          "legendFormat": "{{asset}}/{{market_id}}",
          "format": "table"
