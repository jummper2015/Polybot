{
  "title": "PolyBot — Event-Driven Trading (P11.4)",
  "uid": "polybot-event-driven",
  "tags": [
    "polybot",
    "p11.4",
    "event-driven",
    "events",
    "market-events"
  ],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "id": 100,
      "title": "Events Detected (5m)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(polybot_event_detected_total[5m]))",
          "legendFormat": "Events"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "orange",
                "value": 15
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 101,
      "title": "HALTs Triggered (Total)",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(polybot_event_halt_entries_total)",
          "legendFormat": "HALTs"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "orange",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 102,
      "title": "Blocking Events Active",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(polybot_event_active)",
          "legendFormat": "Blocking"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "✅ CLEAR",
                  "color": "green"
                },
                "1": {
                  "text": "⚠️ 1 BLOCKING",
                  "color": "orange"
                }
              }
            },
            {
              "type": "range",
              "options": {
                "from": 2,
                "to": 999,
                "result": {
                  "text": "🔴 MULTI-BLOCK",
                  "color": "red"
                }
              }
            }
          ]
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 103,
      "title": "HALT Rate (per hour)",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(polybot_event_halt_entries_total[1h]) * 3600",
          "legendFormat": "HALT/h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "textMode": "auto"
      }
    },
    {
      "id": 200,
      "title": "Events Detected — by Type (rate 5m)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(polybot_event_detected_total{event_type=\"price_shock\"}[5m])) by (event_type)",
          "legendFormat": "Price Shock"
        },
        {
          "refId": "B",
          "expr": "sum(rate(polybot_event_detected_total{event_type=\"volume_surge\"}[5m])) by (event_type)",
          "legendFormat": "Volume Surge"
        },
        {
          "refId": "C",
          "expr": "sum(rate(polybot_event_detected_total{event_type=\"expiry_proximity\"}[5m])) by (event_type)",
          "legendFormat": "Expiry Proximity"
        },
        {
          "refId": "D",
          "expr": "sum(rate(polybot_event_detected_total{event_type=\"spread_explosion\"}[5m])) by (event_type)",
          "legendFormat": "Spread Explosion"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "showPoints": "auto",
            "pointSize": 5,
            "stacking": {
              "mode": "none"
            },
            "lineInterpolation": "smooth"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "max",
            "mean",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
