{
  "title": "Polymarket Bot — Trading Dashboard",
  "uid": "polymarket-bot-v1",
  "schemaVersion": 38,
  "version": 2,
  "refresh": "15s",
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["5s", "10s", "30s", "1m", "5m", "15m", "30m", "1h"],
    "time_options": ["5m", "15m", "1h", "3h", "6h", "12h", "24h"]
  },
  "tags": ["polymarket", "trading", "crypto"],
  "templating": {
    "list": [
      {
        "name": "mode",
        "type": "custom",
        "label": "Trading Mode",
        "options": [
          { "value": "paper", "selected": true, "text": "Paper Trading" },
          { "value": "real",  "selected": false, "text": "Real Trading" }
        ]
      },
      {
        "name": "asset",
        "type": "custom",
        "label": "Asset",
        "options": [
          { "value": ".+", "selected": true, "text": "All" },
          { "value": "BTC", "selected": false, "text": "BTC" },
          { "value": "ETH", "selected": false, "text": "ETH" }
        ]
      },
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data Source"
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Deployments",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "expr": "changes(polymarket_bot_uptime_seconds[1m]) > 0",
        "step": "60s",
        "tagKeys": "event",
        "titleFormat": "Bot Restarted",
        "iconColor": "purple",
        "enable": true
      }
    ]
  },

  "panels": [

    {
      "id": 100,
      "title": "🟢 SYSTEM HEALTH",
      "type": "row",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 101,
      "title": "⏱️ Bot Uptime",
      "type": "stat",
      "gridPos": { "x": 0, "y": 1, "w": 4, "h": 4 },
      "targets": [{
        "expr": "polymarket_bot_uptime_seconds",
        "legendFormat": "Uptime"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,    "color": "red"    },
              { "value": 60,   "color": "yellow" },
              { "value": 300,  "color": "green"  }
            ]
          }
        }
      }
    },

    {
      "id": 102,
      "title": "🌐 WebSocket Connections",
      "type": "stat",
      "gridPos": { "x": 4, "y": 1, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(polymarket_ws_connected)",
        "legendFormat": "WS Active"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red"    },
              { "value": 1, "color": "yellow" },
              { "value": 4, "color": "green"  }
            ]
          }
        }
      }
    },

    {
      "id": 103,
      "title": "📡 Market Data Source",
      "type": "stat",
      "gridPos": { "x": 8, "y": 1, "w": 4, "h": 4 },
      "targets": [{
        "expr": "avg(polymarket_market_data_source)",
        "legendFormat": "Source"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "mappings": [
            { "type": "value", "value": "2", "text": "WebSocket" },
            { "type": "value", "value": "1", "text": "REST Fallback" },
            { "type": "value", "value": "0", "text": "Unknown" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,  "color": "red"    },
              { "value": 0.9,"color": "orange"  },
              { "value": 1.9,"color": "green"  }
            ]
          }
        }
      }
    },

    {
      "id": 104,
      "title": "⚡ Circuit Breaker",
      "type": "stat",
      "gridPos": { "x": 12, "y": 1, "w": 4, "h": 4 },
      "targets": [{
        "expr": "polymarket_circuit_breaker_state",
        "legendFormat": "State"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "value": "0", "text": "CLOSED ✅" },
            { "type": "value", "value": "1", "text": "OPEN 🔴" },
            { "type": "value", "value": "2", "text": "HALF-OPEN ⚠️" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,  "color": "green"  },
              { "value": 1,  "color": "red"    },
              { "value": 2,  "color": "orange" }
            ]
          }
        }
      }
    },

    {
      "id": 105,
      "title": "🔌 API Health",
      "type": "stat",
      "gridPos": { "x": 16, "y": 1, "w": 4, "h": 4 },
      "targets": [{
        "expr": "up{job=\"polymarket_bot\"}",
        "legendFormat": "API"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0, "color": "red"   },
              { "value": 1, "color": "green" }
            ]
          }
        }
      }
    },

    {
      "id": 106,
      "title": "📊 DB & Redis Latency (p95)",
      "type": "stat",
      "gridPos": { "x": 20, "y": 1, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(polymarket_db_query_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "DB ms"
        },
        {
          "expr": "histogram_quantile(0.95, rate(polymarket_redis_operation_duration_seconds_bucket[5m])) * 1000",
          "legendFormat": "Redis ms"
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": true },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,   "color": "green"  },
              { "value": 10,  "color": "yellow" },
              { "value": 50,  "color": "orange" },
              { "value": 100, "color": "red"    }
            ]
          }
        }
      }
    },

    {
      "id": 107,
      "title": "🔄 WS Ticks/sec & Reconnections",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 5, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(polymarket_ws_ticks_total[1m])",
          "legendFormat": "Ticks/s — {{market_id}}"
        },
        {
          "expr": "rate(polymarket_ws_reconnects_total[5m])",
          "legendFormat": "Reconnects — {{market_id}}"
        }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 10 } }
      }
    },

    {
      "id": 108,
      "title": "🔍 API Requests by Status",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 5, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(polymarket_api_requests_total{status=~\"2..\"}[1m])) by (endpoint)",
          "legendFormat": "2xx — {{endpoint}}"
        },
        {
          "expr": "sum(rate(polymarket_api_requests_total{status=~\"4..\"}[1m])) by (endpoint)",
          "legendFormat": "4xx — {{endpoint}}"
        },
        {
          "expr": "sum(rate(polymarket_api_requests_total{status=~\"5..\"}[1m])) by (endpoint)",
          "legendFormat": "5xx — {{endpoint}}"
        }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "stacking": { "mode": "normal" } } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "2xx.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "green" } }] },
          { "matcher": { "id": "byRegexp", "options": "4xx.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange" } }] },
          { "matcher": { "id": "byRegexp", "options": "5xx.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "red" } }] }
        ]
      }
    },

    {
      "id": 200,
      "title": "💰 TRADING PERFORMANCE",
      "type": "row",
      "gridPos": { "x": 0, "y": 11, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 201,
      "title": "💵 Balance",
      "type": "stat",
      "gridPos": { "x": 0, "y": 12, "w": 4, "h": 4 },
      "targets": [{
        "expr": "polymarket_paper_balance_usdc",
        "legendFormat": "Balance"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,    "color": "red"    },
              { "value": 500,  "color": "yellow" },
              { "value": 1000, "color": "green"  }
            ]
          }
        }
      }
    },

    {
      "id": 202,
      "title": "📈 PnL Total",
      "type": "stat",
      "gridPos": { "x": 4, "y": 12, "w": 4, "h": 4 },
      "targets": [{
        "expr": "polymarket_pnl_usdc{mode=~\"$mode\"}",
        "legendFormat": "PnL"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": -999, "color": "red"    },
              { "value": 0,    "color": "yellow" },
              { "value": 10,   "color": "green"  }
            ]
          }
        }
      }
    },

    {
      "id": 203,
      "title": "🎯 Open Positions",
      "type": "stat",
      "gridPos": { "x": 8, "y": 12, "w": 4, "h": 4 },
      "targets": [{
        "expr": "polymarket_paper_positions_open",
        "legendFormat": "Positions"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,  "color": "blue"   },
              { "value": 1,  "color": "green"  },
              { "value": 4,  "color": "yellow" },
              { "value": 8,  "color": "red"    }
            ]
          }
        }
      }
    },

    {
      "id": 204,
      "title": "📊 Orders Executed",
      "type": "stat",
      "gridPos": { "x": 12, "y": 12, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(rate(polymarket_orders_total{mode=~\"$mode\"}[5m])) * 300",
        "legendFormat": "Orders/5min"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,  "color": "blue"   },
              { "value": 1,  "color": "green"  },
              { "value": 10, "color": "yellow" }
            ]
          }
        }
      }
    },

    {
      "id": 205,
      "title": "🏆 Win Rate (approx)",
      "type": "stat",
      "gridPos": { "x": 16, "y": 12, "w": 4, "h": 4 },
      "targets": [{
        "expr": "(\n  sum(rate(polymarket_pnl_per_trade_usdc_bucket{le=\"+Inf\",mode=~\"$mode\"}[1h])) -\n  sum(rate(polymarket_pnl_per_trade_usdc_bucket{le=\"0.0\",mode=~\"$mode\"}[1h]))\n) / (\n  sum(rate(polymarket_pnl_per_trade_usdc_count{mode=~\"$mode\"}[1h])) or vector(0)\n) * 100",
        "legendFormat": "Win Rate"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,  "color": "red"    },
              { "value": 40, "color": "yellow" },
              { "value": 55, "color": "green"  }
            ]
          }
        }
      }
    },

    {
      "id": 206,
      "title": "📈 Total Positions ({{mode}})",
      "type": "stat",
      "gridPos": { "x": 20, "y": 12, "w": 4, "h": 4 },
      "targets": [{
        "expr": "sum(polymarket_paper_positions_open)",
        "legendFormat": "Total Open"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,  "color": "green"  },
              { "value": 1,  "color": "yellow" },
              { "value": 4,  "color": "red"    }
            ]
          }
        }
      }
    },

    {
      "id": 207,
      "title": "💹 PnL Acumulado (Time Series)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [{
        "expr": "polymarket_pnl_usdc{mode=~\"$mode\"}",
        "legendFormat": "PnL {{mode}}"
      }],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": { "lineWidth": 3, "fillOpacity": 15, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": -999, "color": "red" },
              { "value": 0,    "color": "green" }
            ]
          }
        }
      }
    },

    {
      "id": 208,
      "title": "📊 PnL Distribution by Exit Reason",
      "type": "barchart",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(increase(polymarket_pnl_per_trade_usdc_bucket{mode=~\"$mode\"}[$__range])) by (le, exit_reason)",
          "legendFormat": "{{exit_reason}} ≤ {{le}}"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 100
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": { "mode": "palette-classic" },
          "custom": {}
        }
      }
    },

    {
      "id": 209,
      "title": "📋 Orders by Side ({{mode}})",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 24, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "rate(polymarket_orders_total{mode=~\"$mode\",side=\"YES\"}[5m])",
          "legendFormat": "BUY YES"
        },
        {
          "expr": "rate(polymarket_orders_total{mode=~\"$mode\",side=\"NO\"}[5m])",
          "legendFormat": "BUY NO"
        }
      ],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 2, "fillOpacity": 20 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "BUY YES" }, "properties": [{ "id": "color", "value": { "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "BUY NO" }, "properties": [{ "id": "color", "value": { "fixedColor": "red" } }] }
        ]
      }
    },

    {
      "id": 210,
      "title": "📉 Slippage Distribution",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 24, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(polymarket_slippage_observed_bucket{mode=~\"$mode\"}[5m])) * 100",
          "legendFormat": "p50 {{mode}}"
        },
        {
          "expr": "histogram_quantile(0.95, rate(polymarket_slippage_observed_bucket{mode=~\"$mode\"}[5m])) * 100",
          "legendFormat": "p95 {{mode}}"
        },
        {
          "expr": "histogram_quantile(0.99, rate(polymarket_slippage_observed_bucket{mode=~\"$mode\"}[5m])) * 100",
          "legendFormat": "p99 {{mode}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "custom": { "lineWidth": 2 } },
        "overrides": [
          { "matcher": { "id": "byRegexp", "options": "p50.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "green" } }] },
          { "matcher": { "id": "byRegexp", "options": "p95.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange" } }] },
          { "matcher": { "id": "byRegexp", "options": "p99.*" }, "properties": [{ "id": "color", "value": { "fixedColor": "red" } }] }
        ]
      }
    },

    {
      "id": 300,
      "title": "🛡️ RISK METRICS",
      "type": "row",
      "gridPos": { "x": 0, "y": 30, "w": 24, "h": 1 },
      "collapsed": false
    },

    {
      "id": 301,
      "title": "⚠️ Daily Drawdown",
      "type": "gauge",
      "gridPos": { "x": 0, "y": 31, "w": 6, "h": 5 },
      "targets": [{
        "expr": "polymarket_risk_drawdown_pct{mode=~\"$mode\"} * 100",
        "legendFormat": "Drawdown"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "minVizValue": 0,
        "maxVizValue": 20,
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,   "color": "green"  },
              { "value": 5,   "color": "yellow" },
              { "value": 10,  "color": "orange" },
              { "value": 15,  "color": "red"    }
            ]
          }
        }
      }
    },

    {
      "id": 302,
      "title": "📊 Portfolio Exposure",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 31, "w": 6, "h": 5 },
      "targets": [{
        "expr": "polymarket_risk_exposure_pct{mode=~\"$mode\"} * 100",
        "legendFormat": "Exposure"
      }],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "values": false },
        "minVizValue": 0,
        "maxVizValue": 100,
        "showThresholdLabels": true,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": 0,  "color": "green"  },
              { "value": 30, "color": "yellow" },
              { "value": 60, "color": "orange" },
              { "value": 80, "color": "red"    }
            ]
          }
        }
      }
    },

    {
      "id": 303,
      "title": "📈 Drawdown + Exposure Trend",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 31, "w": 12, "h": 5 },
      "targets": [
        {
          "expr": "polymarket_risk_drawdown_pct{mode=~\"$mode\"} * 100",
          "legendFormat": "Drawdown %"
        },
        {
          "expr": "polymarket_risk_exposure_pct{mode=~\"$mode\"} * 100",
          "legendFormat": "Exposure %"
        }
      ],
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": { "lineWidth": 2, "fillOpacity": 15 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Drawdown %" }, "properties": [{ "id": "color", "value": { "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "Exposure %" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue" } }] }
        ]
      }
    },

    {
      "id": 304,
      "title": "✅ Risk Decisions (Allow vs Deny)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(polymarket_risk_decisions_total{result=\"allow\",mode=~\"$mode\"}[5m])",
          "legendFormat": "ALLOW"
        },
        {
          "expr": "rate(polymarket_risk_decisions_total{result=\"deny\",mode=~\"$mode\"}[5m])",
          "legendFormat": "DENY — {{rule}}"
        }
      ],
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom" },
