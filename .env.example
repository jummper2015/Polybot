# =============================================================================
#  POLYBOT — Environment Configuration Template
#  =============================================================================
#  Copiar a .env:  cp .env.example .env
#  Validar:        python scripts/check_env.py
#  =============================================================================
#  LEYENDA:
#    🔵 REQUERIDO SIEMPRE (paper y real)
#    🟢 REQUERIDO SOLO REAL TRADING (Fase 9+)
#    🟡 OPCIONAL (tiene default)
#    ⚪ INFORMATIVO (no requerido por el bot)
#  =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 🔵 SECCION 1: VARIABLES REQUERIDAS SIEMPRE
#    Necesarias incluso en modo paper trading.
# ─────────────────────────────────────────────────────────────────────────────

# Base de datos PostgreSQL (connection string)
# Formato: postgresql+asyncpg://user:password@host:5432/polybot
DATABASE_URL=postgresql+asyncpg://polybot:changeme@localhost:5432/polybot

# Redis (cache, estado de ticks, rate limiting)
# Formato: redis://host:6379/0
REDIS_URL=redis://localhost:6379/0

# Bot de Telegram para control operativo
# Obtener de @BotFather en Telegram
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# Chat ID del administrador autorizado
# Obtener de @userinfobot en Telegram
TELEGRAM_CHAT_ID=123456789

# Modo de trading: paper | real
# paper = simulacion sin capital real (Fase 8)
# real  = trading con capital real (Fase 9+, requiere credenciales)
TRADING_MODE=paper

# ─────────────────────────────────────────────────────────────────────────────
# 🟢 SECCION 2: CREDENCIALES POLYMARKET (REAL TRADING)
#    REQUERIDAS para: Fase 9+ (Execution Realism, Real Trading)
#    NO requeridas para: Fase 8 (Data Recording — usa WS publico)
#
#    ⚠️  NUNCA compartas estas variables ni las subas a git.
#    ⚠️  .env esta en .gitignore — verifica antes de hacer commit.
#
#    Obtencion de credenciales:
#    1. Ve a https://polymarket.com/settings/api
#    2. Crea una API Key (necesitas wallet conectada)
#    3. Guarda PRIVATE_KEY (clave privada de tu wallet)
#    4. Guarda API_KEY, API_SECRET, API_PASSPHRASE
#    5. WALLET_ADDRESS es tu direccion publica (0x...)
# ─────────────────────────────────────────────────────────────────────────────

# Clave privada de tu wallet (NUNCA compartir)
# POLYMARKET_PRIVATE_KEY=0x...

# API Key de Polymarket
# POLYMARKET_API_KEY=

# API Secret de Polymarket
# POLYMARKET_API_SECRET=

# API Passphrase de Polymarket
# POLYMARKET_API_PASSPHRASE=

# Direccion publica de tu wallet (segura para logs)
# POLYMARKET_WALLET_ADDRESS=0x...

# ─────────────────────────────────────────────────────────────────────────────
# 🟡 SECCION 3: PARAMETROS DE ESTRATEGIA (OPCIONALES)
#    Tienen valores por defecto. Ajustar segun optimizacion.
# ─────────────────────────────────────────────────────────────────────────────

# Buy Above Threshold (BAT) — Estrategia SECUNDARIA
# Umbral de entrada: yes_price debe superar este valor
BAT_THRESHOLD=0.75
# Ticks consecutivos requeridos para confirmar entrada
BAT_REQUIRED_TICKS=3
# Stop loss como porcentaje del precio de entrada
BAT_STOP_LOSS_PCT=0.15
# Precio objetivo para take profit
BAT_TARGET_PRICE=0.90
# Tamano de posicion en USDC
BAT_POSITION_SIZE_USDC=10.0

# ─────────────────────────────────────────────────────────────────────────────
# 🟡 SECCION 4: PARAMETROS DE RIESGO (OPCIONALES)
#    Limites de seguridad. No modificar sin entender el impacto.
# ─────────────────────────────────────────────────────────────────────────────

# Balance minimo en USDC antes de detener operaciones
RISK_MIN_BALANCE_USDC=50.0
# Drawdown maximo diario antes de kill switch (0.10 = 10%)
RISK_MAX_DAILY_DRAWDOWN=0.10
# Exposicion maxima como fraccion del balance (0.30 = 30%)
RISK_MAX_EXPOSURE_PCT=0.30
# Maximo de posiciones abiertas simultaneas
RISK_MAX_OPEN_POSITIONS=5

# ─────────────────────────────────────────────────────────────────────────────
# 🟡 SECCION 5: PAPER TRADING (OPCIONAL)
# ─────────────────────────────────────────────────────────────────────────────

# Balance inicial para simulacion paper trading (USDC)
PAPER_INITIAL_BALANCE=1000.0

# ─────────────────────────────────────────────────────────────────────────────
# ⚪ SECCION 6: CONFIGURACION ADICIONAL (INFORMATIVO)
#    No usadas directamente por el bot, documentadas para referencia.
# ─────────────────────────────────────────────────────────────────────────────

# Entorno de despliegue: staging | canary | production
# DEPLOY_ENV=staging

# Nivel de log: DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# Host para FastAPI (default: 0.0.0.0)
# API_HOST=0.0.0.0

# Puerto para FastAPI (default: 8000)
# API_PORT=8000

# =============================================================================
#  RESUMEN POR FASE
#  =============================================================================
#
#  FASE 8 (Data Recording):
#    ✅ NO requiere credenciales Polymarket
#    ✅ Solo necesita: DATABASE_URL, REDIS_URL, TELEGRAM_*
#    ✅ El script record_live_data.py usa WS publico + Gamma API publica
#
#  FASE 9+ (Real Trading):
#    ❌ REQUIERE todas las credenciales Polymarket
#    ❌ Descomentar y configurar POLYMARKET_* variables
#    ❌ Cambiar TRADING_MODE=real
#    ❌ Ejecutar: python scripts/check_env.py --phase real
#
# =============================================================================
