# =============================================================================
# Polybot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Then verify your configuration:
#   python scripts/check_env.py
#
# ⚠️  NEVER commit the real .env file — it contains secrets.
# =============================================================================


# ──────────────────────────────────────────────────────────────────────────
# 1. POLYMARKET CLOB API (Required for Real Trading)
# ──────────────────────────────────────────────────────────────────────────
# Get these from your Polymarket account:
#   https://polymarket.com/settings/api-keys
#
# ⚠️  SECURITY: These values are NEVER logged or exposed.
#    The log_sanitizer automatically redacts them from all output.

POLYMARKET_PRIVATE_KEY=        # EIP-712 private key (hex format, 64 chars)
POLYMARKET_API_KEY=            # API key for L2 authentication
POLYMARKET_API_SECRET=         # Secret used to sign API requests
POLYMARKET_API_PASSPHRASE=     # Additional passphrase for CLOB access
POLYMARKET_WALLET_ADDRESS=     # Public wallet address (safe to display)


# ──────────────────────────────────────────────────────────────────────────
# 2. DATABASE (Always Required)
# ──────────────────────────────────────────────────────────────────────────
# PostgreSQL connection with async driver.
# Docker Compose default:
#   postgresql+asyncpg://botuser:botpass@localhost:5432/polymarket_bot

DATABASE_URL=postgresql+asyncpg://botuser:botpass@localhost:5432/polymarket_bot


# ──────────────────────────────────────────────────────────────────────────
# 3. REDIS (Always Required)
# ──────────────────────────────────────────────────────────────────────────
# Used for caching, WebSocket state, rate limiting, and Telegram FSM storage.
# Docker Compose default: redis://localhost:6379/0

REDIS_URL=redis://localhost:6379/0


# ──────────────────────────────────────────────────────────────────────────
# 4. TRADING MODE (Always Required)
# ──────────────────────────────────────────────────────────────────────────
# Choose the initial trading mode.
#   paper — simulated execution with realistic slippage (default, safe)
#   real  — live trading on Polymarket CLOB (requires all API keys above)

TRADING_MODE=paper


# ──────────────────────────────────────────────────────────────────────────
# 5. PAPER TRADING (Required for Paper Mode)
# ──────────────────────────────────────────────────────────────────────────

PAPER_INITIAL_BALANCE=1000.0   # Starting balance in USDC for paper trading


# ──────────────────────────────────────────────────────────────────────────
# 6. TELEGRAM BOT (Always Required)
# ──────────────────────────────────────────────────────────────────────────
# 1. Create a bot with @BotFather on Telegram → get the token
# 2. Get your chat ID (send /start to @userinfobot)

TELEGRAM_BOT_TOKEN=            # From @BotFather — e.g. "123456:ABC-DEF1234..."
TELEGRAM_CHAT_ID=              # Your Telegram chat ID (only authorized user)


# ──────────────────────────────────────────────────────────────────────────
# 7. STRATEGY: BUY ABOVE THRESHOLD (BAT) — Secondary
# ──────────────────────────────────────────────────────────────────────────
# Momentum-based strategy. Read by src/infrastructure/security/secure_config.py.

BAT_THRESHOLD=0.75             # Minimum YES price to enter (0.50–0.95)
BAT_REQUIRED_TICKS=3           # Consecutive ticks above threshold needed (1–20)
BAT_STOP_LOSS_PCT=0.15         # Stop-loss: exit if price drops this % from entry (0.05–0.50)
BAT_TARGET_PRICE=0.90          # Profit target: exit if YES price reaches this (must be > threshold)
BAT_POSITION_SIZE_USDC=10.0    # Position size in USDC per trade (1–500)


# ──────────────────────────────────────────────────────────────────────────
# 8. STRATEGY: MEAN REVERSION (MR) — PRIMARY
# ──────────────────────────────────────────────────────────────────────────
# Buys oversold conditions, sells on mean reversion.
# ⚠️  NOT YET WIRED TO ENV VARS. These parameters are hardcoded via
#     getattr() defaults in src/core/container.py. Setting these env vars
#     has NO effect. Edit container.py directly to change MR behavior.
#     To wire them: add fields to SecureConfig + read in from_env().

# MR_MA_WINDOW=20               # Moving average window for z-score (10–40)
# MR_ENTRY_ZSCORE=-2.0          # Z-score to enter — oversold (-3.0 to -1.0)
# MR_EXIT_ZSCORE=0.0            # Z-score to exit — return to mean (-1.0 to 1.0)
# MR_STOP_LOSS_PCT=0.10         # Stop-loss % from entry (0.05–0.15)
# MR_TIMEOUT_MINUTES=45.0       # Max minutes before forced exit (15–120)
# MR_MAX_SPREAD=0.03            # Max allowed spread for entry
# MR_MIN_VOLUME_USDC=1000.0     # Min 24h volume to consider
# MR_POSITION_SIZE_USDC=10.0    # Position size in USDC (1–500)


# ──────────────────────────────────────────────────────────────────────────
# 9. RISK MANAGEMENT
# ──────────────────────────────────────────────────────────────────────────

RISK_MIN_BALANCE_USDC=50.0     # Minimum balance required to trade (USDC)
RISK_MAX_DAILY_DRAWDOWN=0.10  # Max drawdown from daily peak before blocking (0.0–0.50)
RISK_MAX_EXPOSURE_PCT=0.30     # Max % of total capital exposed at once (0.0–1.0)
RISK_MAX_OPEN_POSITIONS=5      # Max simultaneous open positions (1–20)

# ── Kelly Criterion Sizing ──────────────────────────────────────────────
# ⚠️  NOT YET WIRED TO ENV VARS. Hardcoded in src/core/container.py.
#     Edit container.py directly to change Kelly parameters.

# KELLY_CAP=0.25                # Max Kelly fraction (0.0–0.50)
# KELLY_SAFETY_FACTOR=0.25      # Additional safety multiplier (0.0–1.0)
# KELLY_POSITION_FLOOR=5.0      # Min position size in USDC
# KELLY_POSITION_CAP=50.0       # Max position size in USDC


# ──────────────────────────────────────────────────────────────────────────
# 10. API SERVER
# ──────────────────────────────────────────────────────────────────────────

API_HOST=0.0.0.0               # Bind address (use 127.0.0.1 for local-only)
API_PORT=8000                  # HTTP port for FastAPI + dashboard


# ──────────────────────────────────────────────────────────────────────────
# 11. LOGGING
# ──────────────────────────────────────────────────────────────────────────

LOG_LEVEL=INFO                 # DEBUG, INFO, WARNING, ERROR, CRITICAL
ENV=development                # "development" or "production" (affects log format)


# ──────────────────────────────────────────────────────────────────────────
# 12. OPEN TELEMETRY TRACING (Optional)
# ──────────────────────────────────────────────────────────────────────────
# Distributed tracing via OTLP (gRPC or HTTP).
# If OTEL_TRACES_ENABLED=false or no endpoint, tracing is disabled.

OTEL_TRACES_ENABLED=true                   # Set to "false" to disable tracing
OTEL_SERVICE_NAME=polybot                  # Service name in traces
DEPLOY_ENV=production                      # Deployment environment tag
OTEL_EXPORTER_OTLP_ENDPOINT=               # OTLP collector endpoint
OTEL_EXPORTER_OTLP_PROTOCOL=grpc           # "grpc" or "http/protobuf"
OTEL_INSECURE=true                         # "true" for non-TLS connections


# ──────────────────────────────────────────────────────────────────────────
# 13. DOCKER COMPOSE (container env vars — NOT read by Python code)
# ──────────────────────────────────────────────────────────────────────────
# These are only used by docker-compose.yml or Grafana/Prometheus config.
# The Python application uses DATABASE_URL and REDIS_URL instead.

GRAFANA_ADMIN_PASSWORD=admin               # Initial Grafana admin password
PROMETHEUS_PORT=9090                       # Prometheus target port
POSTGRES_USER=botuser
POSTGRES_PASSWORD=botpass
POSTGRES_DB=polymarket_bot
