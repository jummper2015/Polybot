# .env.example
# NUNCA commitear el .env real — solo este ejemplo

# ── Trading Mode ──────────────────────────────────────────────────────
TRADING_MODE=paper           # "paper" o "real" — default siempre paper

# ── Paper Trading ─────────────────────────────────────────────────────
PAPER_INITIAL_BALANCE=1000.0 # Balance virtual inicial en USDC

# ── Real Trading (SOLO si TRADING_MODE=real) ──────────────────────────
POLYMARKET_PRIVATE_KEY=       # Private key de la wallet (NUNCA compartir)
POLYMARKET_API_KEY=           # API Key del CLOB
POLYMARKET_API_SECRET=        # API Secret del CLOB
POLYMARKET_API_PASSPHRASE=    # Passphrase del CLOB
POLYMARKET_WALLET_ADDRESS=    # Dirección pública de la wallet

# ── Base de datos ──────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/polymarket_bot

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Telegram Bot ──────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=           # Token del bot de Telegram
TELEGRAM_CHAT_ID=             # Chat ID del usuario autorizado

# ── Estrategia (sobreescriben defaults) ───────────────────────────────
BAT_THRESHOLD=0.75
BAT_REQUIRED_TICKS=3
BAT_STOP_LOSS_PCT=0.15
BAT_TARGET_PRICE=0.90
BAT_POSITION_SIZE_USDC=10.0

# ── Risk Engine ───────────────────────────────────────────────────────
RISK_MIN_BALANCE_USDC=50.0
RISK_MAX_DAILY_DRAWDOWN=0.10
RISK_MAX_EXPOSURE_PCT=0.30
RISK_MAX_OPEN_POSITIONS=5